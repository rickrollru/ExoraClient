{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Exora Client Release",
      "description": "Fast client build for playing",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "VIDEORECORDER": "OFF", "DOWNLOAD_GTEST": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-debug",
      "displayName": "Exora Client Debug",
      "description": "Slow build with debug checks, for finding crashes",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "VIDEORECORDER": "OFF", "DOWNLOAD_GTEST": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "displayName": "Exora Client Release", "configurePreset": "windows-release", "targets": ["game-client", "game-server"] },
    { "name": "windows-package", "displayName": "Exora Client Release ZIP", "configurePreset": "windows-release", "targets": ["package_default"] },
    { "name": "windows-debug", "displayName": "Exora Client Debug", "configurePreset": "windows-debug", "targets": ["game-client", "game-server"] }
  ]
}
